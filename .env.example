# Obsidian Auto Spa - Environment Configuration

# Authentication for /admin portal and /api/site API
# Choose a strong secret. Never check into source control.
ADMIN_PASSWORD=

# Production Storage (GitHub contents API)
# Used when NODE_ENV=production or VERCEL=1 to persist site edits.
GITHUB_TOKEN=
GITHUB_REPO=username/repo-name
GITHUB_BRANCH=main

# Lead Forwarding / Dispatch Webhook
# CRITICAL: Must be an HTTPS endpoint operated or trusted by the studio.
# No customer leads, bookings, or payments are processed or stored in local DB.
# Submissions pass authoritative quote calculations and are forwarded with a 7s timeout.
LEAD_WEBHOOK_URL=

# Optional: set by Vercel automatically or local dev
# NODE_ENV=development
