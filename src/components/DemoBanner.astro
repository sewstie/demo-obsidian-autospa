---
import { X } from 'lucide-react';
// Shared verbatim between the demo sites: fixed colours so it reads as the agency's notice, not part of the site theme.
interface Props { banner: { text: string; shortText: string; href: string; dismissLabel: string } }
const { banner } = Astro.props;
---
<aside class="demo-banner">
  <a href={banner.href} target="_blank" rel="noopener"><span class="long">{banner.text}</span><span class="short">{banner.shortText}</span></a>
  <button type="button" aria-label={banner.dismissLabel}><X size={18} aria-hidden="true" /></button>
</aside>
<script is:inline>
  (banner => {
    const key = 'demo-banner-dismissed';
    try { if (sessionStorage.getItem(key)) return banner.remove(); } catch {}
    banner.querySelector('button').addEventListener('click', () => {
      banner.remove();
      try { sessionStorage.setItem(key, '1'); } catch {}
    });
  })(document.currentScript.previousElementSibling);
</script>
<style>
  .demo-banner { display: flex; align-items: center; justify-content: center; gap: 4px; padding-left: 16px; background: #000; color: #fff; font: 700 14px/1.35 system-ui, sans-serif; }
  .demo-banner a { display: flex; align-items: center; min-height: 44px; min-width: 0; color: #ff5733; text-decoration: underline; text-underline-offset: 3px; }
  .demo-banner button { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: #fff; cursor: pointer; }
  .demo-banner :focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  .short { display: none; }
  @media (max-width: 479px) {
    .demo-banner { justify-content: space-between; padding-left: 12px; font-size: 13px; }
    .long { display: none; }
    .short { display: inline; white-space: nowrap; }
  }
</style>
