---
import { Star, Quote } from 'lucide-react';
import type { Site } from '../../schemas/site';
interface Props { reviews: Site['reviews'] }
const { reviews } = Astro.props;
---
<section id="reviews" class="section-shell section-space" aria-labelledby="reviews-title">
  <div class="reviews-heading"><p class="section-label">{reviews.label}</p><h2 id="reviews-title">{reviews.heading}</h2><p class="review-disclaimer">{reviews.disclaimer}</p></div>
  <div class="review-grid">{reviews.items.map(review => <figure class="review-card">
    <div class="review-stars" aria-label={`${review.stars} out of 5 stars`}>{Array.from({ length: review.stars }, () => <Star size={14} fill="currentColor" aria-hidden="true" />)}<Quote className="quote-mark" size={25} strokeWidth={1} aria-hidden="true" /></div>
    <blockquote>{review.quote}</blockquote>
    <figcaption><span class="review-avatar" aria-hidden="true">{review.name.slice(-1)}</span><div><strong>{review.name}</strong><p>{review.vehicle}</p></div></figcaption>
  </figure>)}</div>
</section>
