---
import { ArrowUpRight } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import AdminIsland from '../components/islands/Admin.tsx';
import '../styles/admin.css';
import rawSite from '../data/site.json';
import { siteSchema } from '../schemas/site.ts';
import { asset } from '../lib/paths.ts';

const site = siteSchema.parse(rawSite);
const isStaticDemo = import.meta.env.PUBLIC_STATIC_DEMO === 'true';
---

<Layout site={site} title="Site admin" noindex={true}>
  <div class="admin">
    <header class="admin-bar">
      <div class="admin-wrap">
        <p class="admin-brand"><strong>{site.business.name}</strong><span>Site admin</span></p>
        <a class="admin-link" href={asset('/')}>View site<ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
    </header>
    <main id="main" class="admin-wrap admin-main">
      {isStaticDemo ? (
        <section class="admin-card admin-login">
          <h1>Admin unavailable</h1>
          <p class="admin-note">Editing is turned off in this static preview because it has no server to save changes.</p>
        </section>
      ) : (
        <AdminIsland client:load initialSite={site} />
      )}
    </main>
  </div>
</Layout>
