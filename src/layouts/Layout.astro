---
import '../styles/global.css';
import type { Site } from '../schemas/site';
import { asset } from '../lib/paths';
interface Props { site: Site; title?: string; noindex?: boolean }
const { site, title = site.seo.title, noindex = false } = Astro.props;
const { business } = site;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(asset('/'), Astro.site).href;
const image = new URL(asset(site.hero.image.src), Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': ['LocalBusiness', 'AutomotiveBusiness'],
  name: business.name, description: site.seo.description, url: home,
  telephone: business.phone, email: business.email, image,
  address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.city,
    addressRegion: business.region, postalCode: business.postalCode, addressCountry: 'US' },
  areaServed: business.serviceArea, openingHours: business.hoursSchema,
  hasOfferCatalog: { '@type': 'OfferCatalog', name: site.pricing.heading, itemListElement: site.packages.map(item => ({
    '@type': 'Offer', price: Math.min(...Object.values(item.prices)), priceCurrency: 'USD', itemOffered: { '@type': 'Service', name: item.subtitle },
  })) },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08090b" />
    <meta name="description" content={site.seo.description} />
    {(noindex || site.demo || site.demoBanner) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {['barlow-bold', 'manrope-regular'].map(font => <link rel="preload" as="font" type="font/woff2" href={asset(`/fonts/${font}.woff2`)} crossorigin />)}
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body class="bg-background text-foreground">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      // In-page links scroll and move focus without ever putting a hash in the URL.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      function reveal(hash: string, behavior: ScrollBehavior) {
        const target = document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!target) return false;
        target.scrollIntoView({ behavior });
        (document.getElementById(target.getAttribute('aria-labelledby') ?? '') ?? target).focus({ preventScroll: true });
        return true;
      }
      document.addEventListener('click', event => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]:not(.skip-link)');
        // An island may already have handled the click (the booking CTA opens a dialog instead of scrolling).
        if (!link || event.defaultPrevented || !reveal(link.hash, reduced.matches ? 'auto' : 'smooth')) return;
        event.preventDefault();
        link.closest('details')?.removeAttribute('open');
      });
      if (location.hash) {
        reveal(location.hash, 'instant');
        history.replaceState(null, '', location.pathname + location.search);
      }
      // Inspection light: every [data-light] element under the pointer gets its position as --x / --y.
      document.addEventListener('pointermove', event => {
        if (!(event.target instanceof Element)) return;
        for (let el = event.target.closest<HTMLElement>('[data-light]'); el; el = el.parentElement?.closest<HTMLElement>('[data-light]') ?? null) {
          const box = el.getBoundingClientRect();
          el.style.setProperty('--x', `${((event.clientX - box.left) / box.width) * 100}%`);
          el.style.setProperty('--y', `${((event.clientY - box.top) / box.height) * 100}%`);
        }
      }, { passive: true });
    </script>
  </body>
</html>
